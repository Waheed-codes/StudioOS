# StudioOS Environment Configuration

# Server Port (Render sets this automatically; defaults to 4056 locally)
PORT=4056

# MongoDB Connection String (e.g. from MongoDB Atlas)
# Note: Ensure MongoDB Atlas Network Access has 0.0.0.0/0 allowed so Render can connect.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/StudioOS?retryWrites=true&w=majority

# Initial Admin Credentials (creates or updates admin on server boot)
ADMIN_EMAIL=admin@yourstudio.com
ADMIN_PASSWORD=your_secure_admin_password

# JWT Authentication Secret Key (use a strong random string in production)
SECRET_KEY=generate_a_random_jwt_secret_here

# Allowed CORS Origins (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*
